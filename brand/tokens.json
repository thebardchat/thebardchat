{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "thebardchat brand tokens",
  "version": "1.0.0",
  "description": "Canonical design tokens for the thebardchat / ShaneBrain ecosystem. Single source of truth — every repo and website derives its brand look from these values. Do not redefine colors or fonts downstream; reference this file.",
  "updated": "2026-06-29",
  "color": {
    "brand": {
      "cyan":        { "value": "#00e5ff", "comment": "Primary. Links, headings, glow, primary accent." },
      "cyan-light":  { "value": "#7ee8ff", "comment": "Gradient partner / hover for cyan." },
      "amber":       { "value": "#ffaa00", "comment": "Secondary. Highlights, CTAs, energy readouts." },
      "amber-light": { "value": "#ffd066", "comment": "Gradient partner / hover for amber." },
      "violet":      { "value": "#7c3aed", "comment": "Accent. Stats icons, fire, tertiary highlights." },
      "violet-light":{ "value": "#a78bfa", "comment": "Gradient partner / hover for violet." },
      "green":       { "value": "#b4ff6e", "comment": "Covenant color. Tagline, success, faith/family/sobriety line." }
    },
    "surface": {
      "void":   { "value": "#040910", "comment": "Darkest background." },
      "deep":   { "value": "#070f1c", "comment": "Mid background gradient stop." },
      "panel":  { "value": "#0a1422", "comment": "Card / panel fill." },
      "github": { "value": "#0d1117", "comment": "GitHub canvas — use for shields.io & stat-card bg_color." }
    },
    "structure": {
      "grid-minor": { "value": "#192e4c", "comment": "50px grid lines, technical-drawing background." },
      "grid-major": { "value": "#254469", "comment": "250px grid lines, borders." },
      "steel":      { "value": "#4a6e96", "comment": "Hardware / structural line work." }
    },
    "text": {
      "white":  { "value": "#ffffff" },
      "bright": { "value": "#ddeeff", "comment": "Starfield, emphasis." },
      "dim":    { "value": "#8faec8", "comment": "Body sub-text." },
      "muted":  { "value": "#4d6680", "comment": "Captions, labels, mono micro-text." }
    }
  },
  "font": {
    "display": { "value": "'Space Grotesk', 'Inter', 'Helvetica Neue', sans-serif", "comment": "Headings/wordmark. weight 700, letter-spacing -0.03em." },
    "sans":    { "value": "'Inter', 'Helvetica Neue', sans-serif", "comment": "Body copy." },
    "mono":    { "value": "'JetBrains Mono', 'Fira Code', 'Courier New', monospace", "comment": "Code, readouts, technical labels, taglines." }
  },
  "gradient": {
    "wordmark":  { "value": "linear-gradient(105deg, #00e5ff 0%, #7ee8ff 55%, #ffaa00 100%)", "comment": "The signature cyan→amber lockup gradient." },
    "underline": { "value": "linear-gradient(90deg, rgba(0,229,255,0) 0%, rgba(0,229,255,.9) 20%, rgba(255,170,0,.9) 80%, rgba(255,170,0,0) 100%)" },
    "surface":   { "value": "linear-gradient(135deg, #040910 0%, #070f1c 50%, #040910 100%)" }
  },
  "effect": {
    "glow-soft":   { "value": "drop-shadow(0 0 3px rgba(0,229,255,.6))" },
    "glow-strong": { "value": "drop-shadow(0 0 8px rgba(0,229,255,.8))" },
    "radius":      { "value": "8px" }
  },
  "motif": {
    "comment": "Recurring visual devices that make an asset 'on-brand'. See BRAND.md.",
    "items": ["corner-brackets", "starfield", "scan-line", "technical-grid", "radial-halo", "glow-merge"]
  }
}
